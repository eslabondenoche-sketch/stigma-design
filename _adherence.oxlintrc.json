{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/cards/**",
              "components/core/**",
              "ui_kits/instagram-carousel/**",
              "ui_kits/instagram-carousel/slides/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Ahsing|Playfair Display|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Ahsing, Playfair Display, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|variant|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lemon|lilac|magenta|lime|charcoal)$/]",
        "message": "<Badge> tone must be one of 'lemon' | 'lilac' | 'magenta' | 'lime' | 'charcoal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline)$/]",
        "message": "<Badge> variant must be one of 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BurstShape'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|points|rotation|key|ref|className|style|children)$/]",
        "message": "<BurstShape> doesn't accept that prop. Declared props: tone, size, points, rotation."
      },
      {
        "selector": "JSXOpeningElement[name.name='BurstShape'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lemon|lilac|magenta|lime|charcoal)$/]",
        "message": "<BurstShape> tone must be one of 'lemon' | 'lilac' | 'magenta' | 'lime' | 'charcoal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'dark' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScallopedFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|key|ref|className|style|children)$/]",
        "message": "<ScallopedFrame> doesn't accept that prop. Declared props: children, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScallopedFrame'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lilac|magenta|lemon|lime|charcoal)$/]",
        "message": "<ScallopedFrame> tone must be one of 'lilac' | 'magenta' | 'lemon' | 'lime' | 'charcoal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|icon|tone|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: title, description, icon, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lemon|lilac|magenta|lime)$/]",
        "message": "<ServiceCard> tone must be one of 'lemon' | 'lilac' | 'magenta' | 'lime'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SparkleAccent'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|key|ref|className|style|children)$/]",
        "message": "<SparkleAccent> doesn't accept that prop. Declared props: color, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SparkleAccent'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:lemon|lilac|magenta|lime)$/]",
        "message": "<SparkleAccent> color must be one of 'lemon' | 'lilac' | 'magenta' | 'lime'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|photoSlot|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: quote, name, photoSlot."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransformationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:beforeSlot|afterSlot|caption|stylist|key|ref|className|style|children)$/]",
        "message": "<TransformationCard> doesn't accept that prop. Declared props: beforeSlot, afterSlot, caption, stylist."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
